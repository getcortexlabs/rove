#NEXUS
BEGIN DATA;
  DIMENSIONS NTAX=6 NCHAR=8;
  FORMAT DATATYPE=STANDARD SYMBOLS="0123" MISSING=? GAP=-;
  MATRIX
    Canella-A 00000120
    Canella-B 01102001
    C 1223311?
    D 10330022
    E 0100210{02}
    F 12133011
  ;
END;

BEGIN ASSUMPTIONS;
  OPTIONS DEFTYPE=UNORD;
  TYPESET * character_order = ORD: 2-3 5 8;
END;
